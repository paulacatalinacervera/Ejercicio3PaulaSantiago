# ---------------------------------------------------------------------------
# Modo local (MinIO + DuckDB). Deja LOCAL_MODE=true mientras no tengas AWS.
# Para usar AWS real: LOCAL_MODE=false, borra S3_ENDPOINT_URL y usa tus llaves.
# ---------------------------------------------------------------------------
LOCAL_MODE=true

# AWS S3 / MinIO
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1
S3_BUCKET=mobility-local
S3_PREFIX=mobility
S3_ENDPOINT_URL=http://localhost:9000
S3_ENDPOINT_URL_DOCKER=http://minio:9000

# Kafka (host y contenedores)
KAFKA_BOOTSTRAP=localhost:9092
KAFKA_TOPIC=mobility.gps

# Cassandra
CASSANDRA_HOST=localhost
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=mobility

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=mobility123

# Google Cloud: BigQuery + GCS
# GOOGLE_APPLICATION_CREDENTIALS vacio usa el ADC de gcloud.
GCP_PROJECT_ID=
GCP_DATASET=mobility
GCP_LOCATION=US
GCS_BUCKET=
GCS_PREFIX=mobility
GOOGLE_APPLICATION_CREDENTIALS=

# Opcional: dia simulado para el dashboard (YYYYMMDD). Vacio = hoy.
SIM_DAY=
